MONGODB_URI=mongodb://127.0.0.1:27017/karikku?replicaSet=rs0
MONGODB_DB_NAME=karikku_pos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=
NEXT_PUBLIC_APP_NAME=Karikku POS
# Set true and restart the server to return 503 for pages and APIs during downtime.
MAINTENANCE_MODE=false
# Optional Google Drive backup connection (server-only; never NEXT_PUBLIC).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/backups/google-callback
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Retain this key to decrypt the saved Google refresh token.
BACKUP_TOKEN_KEY=
# Optional Google Drive backup connection (server-only; never NEXT_PUBLIC).
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/backups/google-callback
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Retain this key to decrypt the saved Google refresh token.
BACKUP_TOKEN_KEY=
# Used only by npm run seed:admin. Never commit real values.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
